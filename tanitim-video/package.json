{
  "name": "paraizi-tanitim-video",
  "private": true,
  "version": "1.0.0",
  "description": "Paraİzi tanıtım videosu (Remotion)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Tanitim out/paraizi-tanitim.mp4 --codec=h264 --crf=18 --audio-bitrate=192k --concurrency=3",
    "kare": "remotion still src/index.ts Tanitim out/kare.png",
    "tip": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/fonts": "4.0.539",
    "@remotion/transitions": "4.0.539",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
