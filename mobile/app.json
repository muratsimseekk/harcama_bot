{
  "expo": {
    "name": "Harcama",
    "slug": "harcama-mobil",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "harcama",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.harcama.mobil",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "Paraİzi"
      }
    },
    "android": {
      "package": "com.harcama.mobil",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Harcamalarını sesle eklemek için mikrofon erişimi gerekir."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#D97757"
        }
      ],
      "expo-web-browser",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8731282143908044~6009970530",
          "iosAppId": "ca-app-pub-8731282143908044~2025570052",
          "userTrackingUsageDescription": "Reklamların sana daha alakalı gösterilmesi için kullanılır. İzin vermesen de reklam izleyip kredi kazanabilirsin.",
          "delayAppMeasurementInit": true
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Reklamların sana daha alakalı gösterilmesi için kullanılır. İzin vermesen de reklam izleyip kredi kazanabilirsin."
        }
      ],
      [
        "./plugins/withAndroidAppName",
        "Paraİzi"
      ],
      "expo-asset",
      "expo-font",
      "expo-splash-screen"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b2e4ce51-3042-4535-9644-89f867234215"
      }
    },
    "owner": "muratsimseekk"
  }
}
