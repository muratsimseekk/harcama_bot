# Kopyala: cp .env.example .env  — sonra değerleri doldur.
# EXPO_PUBLIC_ önekli değişkenler uygulama koduna gömülür (gizli anahtar KOYMA).

# Yerel geliştirme: Mac'in LAN IP'si (ipconfig getifaddr en0). Telefon aynı Wi-Fi'de olmalı.
EXPO_PUBLIC_API_URL=http://192.168.1.20:8000

EXPO_PUBLIC_SUPABASE_URL=https://mwuuicgxxruoesutbicv.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# 1 (veya boş) = giriş ekranını atla (yönetici/dev). API'de DEV_BYPASS_USER_ID ayarlı olmalı.
# Yayın (production EAS profili) 0 → e-posta/şifre girişi zorunlu.
EXPO_PUBLIC_DEV_NOAUTH=1

# Sentry hata izleme (opsiyonel; boşsa devre dışı)
EXPO_PUBLIC_SENTRY_DSN=

# SDK 56+ varsayılan fetch'i (expo/fetch) RN tarzı FormData dosya yüklemesini
# ({ uri, name, type }) desteklemiyor → ses yükleme kırılıyor. Klasik RN fetch'e dön.
EXPO_PUBLIC_USE_RN_FETCH=1
